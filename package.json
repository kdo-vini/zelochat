{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx --watch server/index.ts",
    "dev:tunnel": "node scripts/tunnel.js",
    "dev:all": "concurrently -n tunnel,backend,frontend -c yellow,green,cyan \"npm run dev:tunnel\" \"npm run dev:server\" \"npm run dev\"",
    "start": "node --import tsx/esm server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "tsx tests/run-unit-tests.ts",
    "test:takeover": "tsx tests/conversationControl.test.ts && tsx tests/conversationOutbound.test.ts && tsx tests/conversationOutboundWorker.test.ts && tsx tests/aiTakeoverRace.test.ts && tsx tests/fromMeProcessor.test.ts && tsx tests/conversationOutboundAlwaysOn.test.ts && tsx tests/conversationOutboundRpc.integration.test.ts && tsx tests/conversationOutboundIntegration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:customer-journey": "playwright test tests/e2e-ai-customer-journey.spec.ts",
    "test:e2e:takeover": "playwright test tests/qa-human-takeover.spec.ts tests/qa-native-from-me.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "backfill:customers": "tsx scripts/backfill-customers.ts",
    "lint:server": "tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@supabase/supabase-js": "^2.57.0",
    "axios": "^1.15.2",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^6.34.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.2",
    "stripe": "^17.7.0",
    "tsx": "^4.21.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
