# ─── OpenAI ───────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ─── Supabase (frontend) ──────────────────────────────────────────────────
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="..."

# ─── Supabase (server) ────────────────────────────────────────────────────
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="..."

# ─── Server ───────────────────────────────────────────────────────────────
SERVER_PORT=3001
FRONTEND_URL="http://localhost:3000"

# ─── Whatsmiau (Evolution API v2 wrapper) ─────────────────────────────────
WHATSMIAU_API_KEY="..."
WHATSMIAU_INSTANCE="zelochat"
WHATSMIAU_BASE_URL="https://api.whatsmiau.dev"

# URL pública onde o Whatsmiau entrega os webhooks.
# Em dev: deixe vazio — o server lê de .tunnel-url (gerado por scripts/tunnel.js)
# Em produção: defina com o domínio do deploy, ex: https://zelochat.up.railway.app
# WEBHOOK_PUBLIC_URL=

# ─── Email transacional (Resend) ──────────────────────────────────────────────
# Obtenha em: https://resend.com
# Quando ausente, emails são logados no console (no-op seguro para dev).
# RESEND_API_KEY="re_..."
# EMAIL_FROM="ZeloChat <no-reply@zelochat.com.br>"

# ⚠️ DEV SAFETY — defina como "1" em qualquer ambiente local que use o .env de
# produção (mesma instância Whatsmiau). Quando ativo, o servidor NÃO chama
# `setWebhook` na startup — evita que rodar `npm run dev:server` localmente
# sequestre a URL do webhook de produção (ver CLAUDE.md →
# "Local dev steals the production webhook").
# Recomendação: sempre "1" no .env local. Em produção (Railway), deixe ausente
# ou "0" pra que o deploy registre o webhook normalmente.
# WHATSMIAU_DISABLE_WEBHOOK_REGISTER=1
