# ─── OpenAI ───────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ─── Supabase (frontend) ──────────────────────────────────────────────────
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="..."

# ─── Supabase (server) ────────────────────────────────────────────────────
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="..."

# ─── Server ───────────────────────────────────────────────────────────────
SERVER_PORT=3001
FRONTEND_URL="http://localhost:3000"

# Chave server-to-server para sistemas internos da Techne enviarem WhatsApp
# via ZeloChat. Use um valor longo/aleatorio e envie no header:
# X-ZeloChat-Internal-Key: <valor>
# ZELOCHAT_INTERNAL_API_KEY="..."
# Opcional: fixe a empresa Techne sem depender da busca por zelochat_mode='general'
# TECHNE_EMPRESA_ID="..."

# ─── Whatsmiau (Evolution API v2 wrapper) ─────────────────────────────────
WHATSMIAU_API_KEY="..."
WHATSMIAU_INSTANCE="zelochat"
WHATSMIAU_BASE_URL="https://api.whatsmiau.dev"

# URL pública onde o Whatsmiau entrega os webhooks.
# Em dev: deixe vazio — o server lê de .tunnel-url (gerado por scripts/tunnel.js)
# Em produção: defina com o domínio do deploy, ex: https://zelochat.up.railway.app
# WEBHOOK_PUBLIC_URL=

# ─── Email transacional (Resend) ──────────────────────────────────────────────
# Obtenha em: https://resend.com
# Quando ausente, emails são logados no console (no-op seguro para dev).
# RESEND_API_KEY="re_..."
# EMAIL_FROM="ZeloChat <no-reply@zelochat.com.br>"

# ─── Stripe (billing — paywall do WhatsApp) ───────────────────────────────────
# A chave secret é a MESMA do ZeloPDV (mesma conta Stripe, mesma tabela
# `subscriptions`). O webhook que processa eventos vive em
# zelopdv.com.br/api/billing/webhook — ZeloChat só CRIA sessions e abre o
# Customer Portal. Não há webhook do lado de cá.
STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_PRICE_CHAT="price_1TR0xGLUJWyE4PkYcBy0cOoD"        # default — R$97/mês
# STRIPE_PRICE_BUNDLE="price_1TR0xGLUJWyE4PkYY0DMOWLI"      # default — R$147/mês
# STRIPE_BILLING_PORTAL_CONFIGURATION_ID="bpc_..."          # opcional, custom config
PUBLIC_APP_URL="https://chat.zelopdv.com.br"               # base usada nos return_urls

# ⚠️ DEV SAFETY — defina como "1" em qualquer ambiente local que use o .env de
# produção (mesma instância Whatsmiau). Quando ativo, o servidor NÃO chama
# `setWebhook` na startup — evita que rodar `npm run dev:server` localmente
# sequestre a URL do webhook de produção (ver CLAUDE.md →
# "Local dev steals the production webhook").
# Recomendação: sempre "1" no .env local. Em produção (Railway), deixe ausente
# ou "0" pra que o deploy registre o webhook normalmente.
# WHATSMIAU_DISABLE_WEBHOOK_REGISTER=1
