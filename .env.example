# Worker de envio (fila zelochat_outbound_jobs). Cada poll é 1 request PostgREST
# no Supabase; o intervalo ocioso controla o egress. Novos jobs enfileirados por
# este processo acordam o worker na hora, então o ocioso pode ser longo.
OUTBOUND_WORKER_CONCURRENCY=1
OUTBOUND_WORKER_ACTIVE_INTERVAL_MS=1000
OUTBOUND_WORKER_IDLE_INTERVAL_MS=15000
OUTBOUND_WORKER_ACTIVE_WINDOW_MS=30000

# Pedido canônico por WhatsApp
ZELOMENU_INTERNAL_BASE_URL=http://127.0.0.1:3101
ZELO_INTERNAL_API_KEY=
ZELOMENU_INTERNAL_TIMEOUT_MS=4000
WHATSMIAU_DISABLE_WEBHOOK_REGISTER=1

# E2E completo (somente ambiente isolado; nunca use produção)
ZELOCHAT_E2E_CUSTOMER_JOURNEY=0
ZELOCHAT_E2E_ALLOW_WRITES=0
E2E_BASE_URL=http://127.0.0.1:3000
ZELOCHAT_E2E_API_URL=http://127.0.0.1:3001
ZELOCHAT_E2E_EMAIL=
ZELOCHAT_E2E_PASSWORD=
ZELOCHAT_E2E_INSTANCE=e2e-
ZELOCHAT_E2E_WEBHOOK_TOKEN=
ZELOCHAT_E2E_JID=
ZELOCHAT_E2E_EXPECTED_SUPABASE_REF=
ZELOCHAT_E2E_EXPECTED_EMPRESA_ID=
