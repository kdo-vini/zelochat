[
  {
    "name": "fulfillment.deliveryFee / deliveryFeeToConfirm ecoados (a loja calcula a taxa, nunca o cliente)",
    "body": {
      "type": "open_or_update_draft",
      "empresaId": "10000000-0000-4000-8000-0000000000f1",
      "remoteJid": "5511900000001@s.whatsapp.net",
      "messageId": "wamid.rejected-fee-000001",
      "conversationControlId": "60000000-0000-4000-8000-0000000000f1",
      "conversationEpoch": "7",
      "orderingId": "30000000-0000-4000-8000-000000000001",
      "expectedRevision": 1,
      "draft": {
        "items": [],
        "fulfillment": {
          "type": "delivery",
          "deliveryFee": 8,
          "deliveryFeeToConfirm": false
        }
      }
    },
    "expectedError": {
      "error": "COMANDO_INVALIDO",
      "message": "A taxa de entrega é calculada pela loja."
    }
  },
